# Lighthouse Bot — Caddyfile
# Puertos: 9080 (HTTP) y 9443 (HTTPS)
# TLS interno (CA autogenerada por Caddy) — sin Let's Encrypt todavía
# El dominio público se configura cuando el humano decida la opción de exposición (ver ADR-004)
#
# Para acceder durante setup/testing, usa SSH tunnel:
#   ssh -L 9443:localhost:9443 noreply@soporte.lamarque.mx
# Luego abre https://n8n.localhost:9443 etc. (acepta el certificado self-signed)

{
  # Puertos de escucha no estándar
  http_port 9080
  https_port 9443

  # Logs de acceso (JSON, estructurado)
  log {
    format json
  }
}

# n8n — Orquestador de workflows
n8n.localhost:9443 {
  tls internal

  reverse_proxy n8n:5678 {
    health_uri /healthz
    health_interval 30s
  }
}

# Chatwoot — Bandeja de conversaciones
chatwoot.localhost:9443 {
  tls internal

  reverse_proxy chatwoot-web:3000 {
    health_interval 30s
  }
}

# Evolution API — Gateway WhatsApp
evolution.localhost:9443 {
  tls internal

  reverse_proxy evolution-api:8080 {
    health_interval 30s
  }
}

# Booksy Executor — API interna (no exponer públicamente)
# Solo accesible en loopback via tunnel para debugging
booksy.localhost:9443 {
  tls internal

  # Restricción: solo desde loopback
  @not_local not remote_ip 127.0.0.1 ::1
  abort @not_local

  reverse_proxy booksy-executor:8000 {
    health_uri /health
    health_interval 30s
  }
}

# HTTP → HTTPS redirect en puerto 9080
:9080 {
  redir https://{host}:9443{uri} permanent
}
