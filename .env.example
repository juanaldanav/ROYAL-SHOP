# =============================================================================
# Lighthouse Bot — Variables de entorno
# Copia este archivo a .env en la VM (/opt/lighthouse-bot/.env)
# NUNCA commitees el .env real. Este archivo es solo documentación.
# =============================================================================

# --- Conexión (solo usadas por scripts locales / deploy.ps1) ---
VM_HOST=soporte.lamarque.mx
VM_BOOTSTRAP_USER=noreply
VM_DEPLOY_USER=lighthouse
PROJECT_ROOT=D:\lighthouse bot
REMOTE_PROJECT_ROOT=/opt/lighthouse-bot

# --- Negocio ---
# Nombre de la barbería (aparece en mensajes del bot)
BARBERSHOP_NAME=
# Nombre corto de la sucursal 1 (ej: "Centro", "Ley")
BARBERSHOP_LOCATION_1_NAME=
# Nombre corto de la sucursal 2
BARBERSHOP_LOCATION_2_NAME=
# Zona horaria de presentación (siempre America/Mazatlan para Culiacán)
BARBERSHOP_TIMEZONE=America/Mazatlan

# --- Gemini / Google AI Studio ---
# Obtener en: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# Modelo configurable (default: gemini-2.5-flash-lite — NO usar 1.5 Flash, deprecado)
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Postgres ---
# Inventar una password fuerte (32+ chars)
POSTGRES_PASSWORD=changeme_strong_32chars
POSTGRES_USER=postgres
POSTGRES_DB=postgres
# Credenciales para n8n
N8N_DB_USER=n8n_user
N8N_DB_PASSWORD=changeme_n8n
N8N_DB_NAME=n8n_db
# Credenciales para Chatwoot
CHATWOOT_DB_USER=chatwoot_user
CHATWOOT_DB_PASSWORD=changeme_chatwoot
CHATWOOT_DB_NAME=chatwoot_db

# --- Redis ---
# Dejar vacío o poner password si quieres auth en Redis
REDIS_PASSWORD=

# --- n8n ---
# Usuario y password para la UI de n8n (Basic Auth)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme_n8n_ui
# Clave de encriptación para credenciales guardadas en n8n
N8N_ENCRYPTION_KEY=changeme_hex_32bytes

# --- Evolution API ---
# Se autogenera en el primer arranque; ver logs para obtenerla
EVOLUTION_API_KEY=changeme_uuid
# Instancia de WhatsApp (nombre interno, sin espacios)
EVOLUTION_INSTANCE_NAME=lighthouse_wa

# --- Chatwoot ---
# Generar con: openssl rand -hex 64
CHATWOOT_SECRET_KEY_BASE=changeme_hex_128chars
# Email del admin de Chatwoot
CHATWOOT_ADMIN_EMAIL=admin@example.com
CHATWOOT_ADMIN_PASSWORD=changeme_chatwoot_ui

# --- Booksy Sucursal 1 ---
# Cuenta de dueño en Booksy (email + password)
BOOKSY_USERNAME_SUC1=
BOOKSY_PASSWORD_SUC1=
# ID de sucursal en Booksy (visible en la URL de la agenda)
BOOKSY_LOCATION_ID_SUC1=

# --- Booksy Sucursal 2 ---
BOOKSY_USERNAME_SUC2=
BOOKSY_PASSWORD_SUC2=
BOOKSY_LOCATION_ID_SUC2=

# --- Caddy ---
# Dominio interno (se usa para TLS auto-generado local)
# Para producción pública, ver ADR-004
CADDY_DOMAIN=localhost
