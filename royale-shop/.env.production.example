# Production environment variables for royaleshop-pos
# Copy this file to .env.production and fill in real values.
# Never commit .env.production to version control.

# ─── Database ─────────────────────────────────────────────────────────────────
# Connects to the existing royaleshop-postgres container via host network bridge.
DATABASE_URL=postgresql://royale:royale2026@host.docker.internal:5432/royaleshop

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://soporte.lamarque.mx
NODE_ENV=production

# ─── External services ────────────────────────────────────────────────────────
# WhatsApp microservice (if running on the same VM)
WHATSAPP_SERVICE_URL=http://localhost:3001
