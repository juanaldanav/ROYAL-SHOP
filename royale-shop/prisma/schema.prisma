generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── TENANT ───────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  phone     String?
  logoUrl   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches      Branch[]
  users         User[]
  categories    Category[]
  products      Product[]
  services      Service[]
  sales         Sale[]
  cashCuts      CashCut[]
  branchStocks  BranchStock[]
  transfers     Transfer[]
}

// ─── BRANCH ───────────────────────────────────────────────────────────────────

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  address   String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  users           User[]
  sales           Sale[]
  cashCuts        CashCut[]
  branchStocks    BranchStock[]
  transfersFrom   Transfer[]    @relation("TransfersFrom")
  transfersTo     Transfer[]    @relation("TransfersTo")
}

// ─── USER ─────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String?
  email     String   @unique
  name      String
  role      UserRole @default(CASHIER)
  pin       String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant             Tenant     @relation(fields: [tenantId], references: [id])
  branch             Branch?    @relation(fields: [branchId], references: [id])
  sales              Sale[]
  cashCuts           CashCut[]
  transfersCreated   Transfer[] @relation("TransfersCreated")
  transfersConfirmed Transfer[] @relation("TransfersConfirmed")
}

enum UserRole {
  OWNER
  MANAGER
  CASHIER
}

// ─── CATEGORY ─────────────────────────────────────────────────────────────────

model Category {
  id        String       @id @default(cuid())
  tenantId  String
  name      String
  type      CategoryType @default(PRODUCT)
  sortOrder Int          @default(0)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]
  services Service[]

  @@unique([tenantId, name, type])
}

enum CategoryType {
  PRODUCT
  SERVICE
}

// ─── PRODUCT ──────────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  categoryId  String?
  sku         String?
  barcode     String?
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  cost        Decimal? @db.Decimal(10, 2)
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  category      Category?     @relation(fields: [categoryId], references: [id])
  saleItems     SaleItem[]
  branchStocks  BranchStock[]
  transferItems TransferItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, active])
}

// ─── BRANCH STOCK (stock por sucursal) ────────────────────────────────────────

model BranchStock {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String
  productId String
  stock     Int      @default(0)
  minStock  Int      @default(0)
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([tenantId, branchId, productId])
  @@index([tenantId, branchId])
}

// ─── SERVICE ──────────────────────────────────────────────────────────────────

model Service {
  id          String   @id @default(cuid())
  tenantId    String
  categoryId  String?
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  duration    Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  category  Category?  @relation(fields: [categoryId], references: [id])
  saleItems SaleItem[]

  @@index([tenantId, active])
}

// ─── SALE ─────────────────────────────────────────────────────────────────────

model Sale {
  id        String        @id @default(cuid())
  tenantId  String
  branchId  String
  userId    String
  cashCutId String?
  folio     String?

  subtotal Decimal @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  tax      Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  paymentMethod    PaymentMethod @default(CASH)
  amountPaid       Decimal       @db.Decimal(10, 2)
  change           Decimal       @default(0) @db.Decimal(10, 2)
  // Desglose para pago mixto (solo se usa cuando paymentMethod = MIXED)
  cashAmount       Decimal       @default(0) @db.Decimal(10, 2)
  cardAmount       Decimal       @default(0) @db.Decimal(10, 2)
  transferAmount   Decimal       @default(0) @db.Decimal(10, 2)

  customerName  String?
  customerPhone String?
  customerEmail String?

  status    SaleStatus @default(COMPLETED)
  notes     String?
  createdAt DateTime   @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  branch   Branch    @relation(fields: [branchId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  cashCut  CashCut?  @relation(fields: [cashCutId], references: [id])
  items    SaleItem[]

  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, cashCutId])
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  MIXED
}

enum SaleStatus {
  COMPLETED
  REFUNDED
  CANCELLED
}

// ─── SALE ITEM ────────────────────────────────────────────────────────────────

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String?
  serviceId String?

  name     String
  price    Decimal  @db.Decimal(10, 2)
  cost     Decimal? @db.Decimal(10, 2)
  quantity Int      @default(1)
  subtotal Decimal  @db.Decimal(10, 2)

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])
}

// ─── CASH CUT ─────────────────────────────────────────────────────────────────

model CashCut {
  id       String    @id @default(cuid())
  tenantId String
  branchId String
  userId   String
  openedAt DateTime  @default(now())
  closedAt DateTime?

  openingBalance Decimal  @db.Decimal(10, 2)
  totalSales     Decimal? @db.Decimal(10, 2)
  expectedCash   Decimal? @db.Decimal(10, 2)
  countedCash    Decimal? @db.Decimal(10, 2)
  difference     Decimal? @db.Decimal(10, 2)

  status CashCutStatus @default(OPEN)
  notes  String?

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch  @relation(fields: [branchId], references: [id])
  user   User    @relation(fields: [userId], references: [id])
  sales  Sale[]

  @@index([tenantId, branchId, status])
}

enum CashCutStatus {
  OPEN
  CLOSED
}

// ─── TRANSFER (traspaso de inventario entre sucursales) ───────────────────────

model Transfer {
  id           String         @id @default(cuid())
  tenantId     String
  fromBranchId String
  toBranchId   String
  createdById  String
  confirmedById String?
  status       TransferStatus @default(PENDING)
  notes        String?
  createdAt    DateTime       @default(now())
  confirmedAt  DateTime?

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  fromBranch  Branch       @relation("TransfersFrom", fields: [fromBranchId], references: [id])
  toBranch    Branch       @relation("TransfersTo", fields: [toBranchId], references: [id])
  createdBy   User         @relation("TransfersCreated", fields: [createdById], references: [id])
  confirmedBy User?        @relation("TransfersConfirmed", fields: [confirmedById], references: [id])
  items       TransferItem[]

  @@index([tenantId, fromBranchId, status])
  @@index([tenantId, toBranchId, status])
}

model TransferItem {
  id         String @id @default(cuid())
  transferId String
  productId  String
  quantity   Int

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
}

enum TransferStatus {
  PENDING
  CONFIRMED
  CANCELLED
}
