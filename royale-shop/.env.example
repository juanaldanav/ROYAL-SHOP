# ─── Base de Datos ────────────────────────────────────────────────────────────
# En producción (Docker Compose en Linux): usa el nombre del servicio Compose
DATABASE_URL=postgresql://royale:CHANGE_ME@royaleshop-postgres:5432/royaleshop
# En desarrollo local (SSH tunnel): usa localhost:5432

# ─── App ──────────────────────────────────────────────────────────────────────
# Dominio público — se bake en el build de Next.js (NEXT_PUBLIC_ = compilado en cliente)
NEXT_PUBLIC_APP_URL=https://royalshop.lamarque.mx

# ─── Microservicio WhatsApp ───────────────────────────────────────────────────
# URL interna del container whatsapp-svc (nunca expuesto al exterior)
WHATSAPP_SERVICE_URL=http://whatsapp-svc:3001

# ─── SMTP (envío de ticket por correo — Req 5) ───────────────────────────────
# Transport global. Si falta cualquiera, NO se envían correos (no-op seguro).
# El remitente (FROM) es el "Correo del negocio" configurado por tenant en /configuracion.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Seguridad ────────────────────────────────────────────────────────────────
# Endpoint de reset de BD (solo dev/staging) — usa clave larga y aleatoria
RESET_SECRET=cambia_esto_por_algo_seguro_32chars
