# ── Base de datos ────────────────────────────────────────────────────────────
# PostgreSQL en Docker (mismo servidor)
DATABASE_URL=postgresql://royale:TU_PASSWORD@localhost:5432/royaleshop

# ── Seguridad ─────────────────────────────────────────────────────────────────
