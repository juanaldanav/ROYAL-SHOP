{
  "name": "01 WhatsApp Inbound",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-inbound",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-inbound",
      "name": "Evolution Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 300],
      "notes": "Recibe eventos de Evolution API. Configurar en Evolution: POST http://n8n:5678/webhook/whatsapp-inbound"
    },
    {
      "parameters": {
        "jsCode": "// Extraer campos relevantes del evento Evolution API v2\nconst body = $input.item.json.body || $input.item.json;\n\nconst data = body.data || {};\nconst key = data.key || {};\nconst message = data.message || {};\n\nconst msgId = key.id || '';\nconst remoteJid = key.remoteJid || '';\nconst fromMe = key.fromMe || false;\nconst phone = remoteJid.replace('@s.whatsapp.net', '').replace('@g.us', '');\nconst text = message.conversation || message.extendedTextMessage?.text || '';\nconst timestamp = data.messageTimestamp || Math.floor(Date.now() / 1000);\nconst instanceName = body.instance || '';\n\n// Ignorar mensajes propios, grupos y mensajes vacíos\nif (fromMe || remoteJid.includes('@g.us') || !text.trim()) {\n  return [{ json: { skip: true } }];\n}\n\nreturn [{\n  json: {\n    msgId,\n    phone,\n    text: text.trim(),\n    timestamp,\n    instanceName,\n    remoteJid\n  }\n}];"
      },
      "id": "normalize-message",
      "name": "Normalize Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false },
          "conditions": [
            {
              "leftValue": "={{ $json.skip }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ]
        }
      },
      "id": "filter-skip",
      "name": "Skip?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "respondWith": "noData",
        "options": {}
      },
      "id": "respond-skip",
      "name": "Respond OK (skip)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [850, 200]
    },
    {
      "parameters": {
        "operation": "set",
        "name": "={{ 'dedup:msg:' + $json.msgId }}",
        "value": "1",
        "ttl": 3600
      },
      "id": "redis-dedup-set",
      "name": "Redis Dedup SET NX",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [850, 400],
      "notes": "SET msg:<id> 1 EX 3600 NX — si ya existe, es duplicado"
    },
    {
      "parameters": {
        "jsCode": "// Verificar si el SET fue exitoso (NX = only if not exists)\n// n8n Redis node retorna null si la key ya existía\nconst result = $input.item.json;\nif (result === null || result.success === false) {\n  return [{ json: { duplicate: true } }];\n}\nreturn [{ json: { ...result, duplicate: false } }];"
      },
      "id": "check-duplicate",
      "name": "Check Duplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 400]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.duplicate }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ]
        }
      },
      "id": "filter-duplicate",
      "name": "Duplicate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1250, 400]
    },
    {
      "parameters": {
        "respondWith": "noData",
        "options": {}
      },
      "id": "respond-duplicate",
      "name": "Respond OK (dup)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "operation": "incr",
        "name": "={{ 'ratelimit:' + $json.phone }}"
      },
      "id": "redis-rate-incr",
      "name": "Redis Rate INCR",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [1450, 500],
      "notes": "Contador de mensajes por número/minuto"
    },
    {
      "parameters": {
        "jsCode": "// Rate limit: máx 10 mensajes/minuto por número\nconst count = $input.item.json;\nconst phone = $('Normalize Message').item.json.phone;\n\nif (count > 10) {\n  return [{ json: { rateLimited: true, phone } }];\n}\n\n// Primera vez en este minuto: set TTL de 60s\nreturn [{ json: { rateLimited: false, count, phone } }];"
      },
      "id": "check-rate-limit",
      "name": "Check Rate Limit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1650, 500]
    },
    {
      "parameters": {
        "workflowId": "={{ $vars.ROUTER_WORKFLOW_ID }}",
        "workflowInputs": {
          "values": [
            { "name": "phone", "value": "={{ $('Normalize Message').item.json.phone }}" },
            { "name": "text", "value": "={{ $('Normalize Message').item.json.text }}" },
            { "name": "msgId", "value": "={{ $('Normalize Message').item.json.msgId }}" },
            { "name": "instanceName", "value": "={{ $('Normalize Message').item.json.instanceName }}" }
          ]
        }
      },
      "id": "call-router",
      "name": "Call Intent Router",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [1850, 500],
      "notes": "Pasa a 02-intent-router.json"
    },
    {
      "parameters": {
        "respondWith": "noData",
        "options": {}
      },
      "id": "respond-ok",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [2050, 500]
    }
  ],
  "connections": {
    "Evolution Webhook": { "main": [[{ "node": "Normalize Message", "type": "main", "index": 0 }]] },
    "Normalize Message": { "main": [[{ "node": "Skip?", "type": "main", "index": 0 }]] },
    "Skip?": {
      "main": [
        [{ "node": "Respond OK (skip)", "type": "main", "index": 0 }],
        [{ "node": "Redis Dedup SET NX", "type": "main", "index": 0 }]
      ]
    },
    "Redis Dedup SET NX": { "main": [[{ "node": "Check Duplicate", "type": "main", "index": 0 }]] },
    "Check Duplicate": { "main": [[{ "node": "Duplicate?", "type": "main", "index": 0 }]] },
    "Duplicate?": {
      "main": [
        [{ "node": "Respond OK (dup)", "type": "main", "index": 0 }],
        [{ "node": "Redis Rate INCR", "type": "main", "index": 0 }]
      ]
    },
    "Redis Rate INCR": { "main": [[{ "node": "Check Rate Limit", "type": "main", "index": 0 }]] },
    "Check Rate Limit": { "main": [[{ "node": "Call Intent Router", "type": "main", "index": 0 }]] },
    "Call Intent Router": { "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": false,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "tags": [{ "name": "lighthouse" }]
}
