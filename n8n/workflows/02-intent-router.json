{
  "name": "02 Intent Router",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// Pre-filtro determinista por regex/keywords\n// Evita llamar a Gemini para intents obvios\nconst text = ($input.item.json.text || '').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\n\nconst patterns = {\n  book: [/\\bagendar?\\b/, /\\bquiero cita\\b/, /\\bhay (lugar|espacio)\\b/, /\\bdisponib/, /\\bcuando pueden\\b/, /\\ba que hora\\b/, /\\bpara (hoy|manana|el lunes|el martes|el miercoles|el jueves|el viernes|el sabado)\\b/],\n  cancel: [/\\bcancelar?\\b/, /\\bya no (voy|puedo)\\b/, /\\bquiten mi cita\\b/, /\\bnecesito cancelar\\b/],\n  reschedule: [/\\bcambiar?\\b/, /\\breagendar?\\b/, /\\bmover (mi )?cita\\b/, /\\botro dia\\b/, /\\botro horario\\b/],\n  info: [/\\bcuanto (cuesta|vale|cobran)\\b/, /\\bprecios?\\b/, /\\bque (servicios|cortes)\\b/, /\\bdonde estan\\b/, /\\bdirec/, /\\bhorario\\b/, /\\ba que hora (abren|cierran|atienden)\\b/],\n  human_handoff: [/\\bhablar con\\b/, /\\bdirector\\b/, /\\bdueno\\b/, /\\bqueja\\b/, /\\bmal (servicio|trato)\\b/, /\\bgerente\\b/]\n};\n\nfor (const [intent, regexList] of Object.entries(patterns)) {\n  for (const regex of regexList) {\n    if (regex.test(text)) {\n      return [{ json: { ...($input.item.json), intent, source: 'regex' } }];\n    }\n  }\n}\n\n// No matcheó: marcar para llamada a Gemini\nreturn [{ json: { ...($input.item.json), intent: null, source: 'needs_gemini' } }];"
      },
      "id": "regex-prefiler",
      "name": "Regex Pre-filter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.source }}",
              "rightValue": "needs_gemini",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "id": "needs-gemini",
      "name": "Needs Gemini?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/{{ $vars.GEMINI_MODEL || 'gemini-2.5-flash-lite' }}:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [{ "name": "key", "value": "={{ $vars.GEMINI_API_KEY }}" }]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "contents",
              "value": "=[{ \"parts\": [{ \"text\": {{ JSON.stringify(($('Regex Pre-filter').item.json.intentClassifierPrompt || 'Clasifica: ' + $('Regex Pre-filter').item.json.text)) }} }] }]"
            },
            { "name": "generationConfig", "value": "={ \"maxOutputTokens\": 10, \"temperature\": 0 }" }
          ]
        },
        "options": {}
      },
      "id": "gemini-classify",
      "name": "Gemini Intent Classify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 200],
      "notes": "Llama a Gemini con intent_classifier.md. Configura GEMINI_API_KEY en n8n variables."
    },
    {
      "parameters": {
        "jsCode": "// Parsear respuesta de Gemini y extraer el intent\nconst response = $input.item.json;\nconst candidates = response.candidates || [];\nconst text = candidates[0]?.content?.parts?.[0]?.text?.trim().toLowerCase() || 'ambiguous';\n\nconst validIntents = ['book', 'reschedule', 'cancel', 'info', 'off_topic', 'human_handoff', 'ambiguous'];\nconst intent = validIntents.includes(text) ? text : 'ambiguous';\n\nconst original = $('Regex Pre-filter').item.json;\nreturn [{ json: { ...original, intent, source: 'gemini' } }];"
      },
      "id": "parse-gemini-intent",
      "name": "Parse Gemini Intent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 200]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.intent }}", "rightValue": "book", "operator": { "type": "string", "operation": "equals" } }] }, "outputKey": "book" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.intent }}", "rightValue": "reschedule", "operator": { "type": "string", "operation": "equals" } }] }, "outputKey": "reschedule" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.intent }}", "rightValue": "cancel", "operator": { "type": "string", "operation": "equals" } }] }, "outputKey": "cancel" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.intent }}", "rightValue": "info", "operator": { "type": "string", "operation": "equals" } }] }, "outputKey": "info" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.intent }}", "rightValue": "off_topic", "operator": { "type": "string", "operation": "equals" } }] }, "outputKey": "off_topic" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.intent }}", "rightValue": "human_handoff", "operator": { "type": "string", "operation": "equals" } }] }, "outputKey": "human_handoff" }
          ],
          "fallbackOutput": "ambiguous"
        }
      },
      "id": "switch-intent",
      "name": "Switch by Intent",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "workflowId": "={{ $vars.BOOKING_WORKFLOW_ID }}",
        "workflowInputs": { "values": [{ "name": "data", "value": "={{ $json }}" }] }
      },
      "id": "call-booking",
      "name": "→ Booking Flow",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [1250, 100]
    },
    {
      "parameters": {
        "workflowId": "={{ $vars.BOOKING_WORKFLOW_ID }}",
        "workflowInputs": { "values": [{ "name": "data", "value": "={{ $json }}" }] }
      },
      "id": "call-reschedule",
      "name": "→ Reschedule Flow",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [1250, 220]
    },
    {
      "parameters": {
        "workflowId": "={{ $vars.BOOKING_WORKFLOW_ID }}",
        "workflowInputs": { "values": [{ "name": "data", "value": "={{ $json }}" }] }
      },
      "id": "call-cancel",
      "name": "→ Cancel Flow",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [1250, 340]
    },
    {
      "parameters": {
        "workflowId": "={{ $vars.HANDOFF_WORKFLOW_ID }}",
        "workflowInputs": { "values": [{ "name": "data", "value": "={{ $json }}" }] }
      },
      "id": "call-handoff",
      "name": "→ Human Handoff",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [1250, 460]
    },
    {
      "parameters": {
        "jsCode": "// Respuesta canned para off-topic\nconst templates = [\n  'Jaja solo te puedo apoyar con lo de citas y el salón. ¿Agendamos algo?',\n  'Solo te puedo apoyar con citas por este medio. ¿En qué te ayudo con el salón?',\n  'Eso sí se me escapa, pero si quieres una cita aquí estoy. ¿Te agendo?'\n];\nconst reply = templates[Math.floor(Math.random() * templates.length)];\nreturn [{ json: { ...($input.item.json), reply } }];"
      },
      "id": "off-topic-reply",
      "name": "Off-topic Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 580]
    }
  ],
  "connections": {
    "Regex Pre-filter": { "main": [[{ "node": "Needs Gemini?", "type": "main", "index": 0 }]] },
    "Needs Gemini?": {
      "main": [
        [{ "node": "Gemini Intent Classify", "type": "main", "index": 0 }],
        [{ "node": "Switch by Intent", "type": "main", "index": 0 }]
      ]
    },
    "Gemini Intent Classify": { "main": [[{ "node": "Parse Gemini Intent", "type": "main", "index": 0 }]] },
    "Parse Gemini Intent": { "main": [[{ "node": "Switch by Intent", "type": "main", "index": 0 }]] },
    "Switch by Intent": {
      "main": [
        [{ "node": "→ Booking Flow", "type": "main", "index": 0 }],
        [{ "node": "→ Reschedule Flow", "type": "main", "index": 0 }],
        [{ "node": "→ Cancel Flow", "type": "main", "index": 0 }],
        [{ "node": "→ Human Handoff", "type": "main", "index": 0 }],
        [{ "node": "Off-topic Reply", "type": "main", "index": 0 }],
        [{ "node": "→ Human Handoff", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "tags": [{ "name": "lighthouse" }]
}
